# Настройки сервера. Поменяй под себя перед деплоем.
# Email-ы с безлимитом (через запятую). Вход только с подтверждённым email (Google вход подходит).
ADMIN_EMAILS=your-email@gmail.com
# Цена 30 дней доступа
PRICE=4.99
CURRENCY=EUR
# sandbox для тестов, live для настоящих платежей
PAYPAL_ENV=sandbox
# Сколько бесплатных панорам на устройство
FREE_PHOTOS=5
# Сколько дней даёт одна оплата
SUB_DAYS=30
